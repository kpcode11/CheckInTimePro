<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.studentmanager.controller.SignUpController" style="-fx-background-color: -color-bg-subtle;">
    <VBox alignment="CENTER" maxWidth="400" maxHeight="550" spacing="15" styleClass="card" style="-fx-background-color: -color-bg-default; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 15, 0, 0, 5);">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>
        
        <Label text="Create Account" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        <Label text="StudentManager Pro" style="-fx-text-fill: -color-fg-muted;"/>
        
        <VBox spacing="5">
            <Label text="Username"/>
            <TextField fx:id="usernameField" promptText="Choose a username"/>
        </VBox>
        
        <VBox spacing="5">
            <Label text="Password"/>
            <PasswordField fx:id="passwordField" promptText="Create a password"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <ProgressBar fx:id="passwordStrengthMeter" progress="0.0" prefWidth="150" prefHeight="10"/>
                <Label fx:id="passwordStrengthLabel" style="-fx-font-size: 11px;"/>
            </HBox>
        </VBox>
        
        <VBox spacing="5">
            <Label text="Confirm Password"/>
            <PasswordField fx:id="confirmPasswordField" promptText="Re-enter your password"/>
        </VBox>
        
        <Label fx:id="errorLabel" textFill="red" wrapText="true"/>
        
        <Button text="Sign Up" maxWidth="Infinity" onAction="#handleSignUp" styleClass="accent"/>
        
        <HBox alignment="CENTER" spacing="5">
            <Label text="Already have an account?"/>
            <Hyperlink text="Login" onAction="#handleGoToLogin"/>
        </HBox>
    </VBox>
</StackPane>
