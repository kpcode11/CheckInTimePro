<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.studentmanager.controller.ReportsController" style="-fx-background-color: transparent;">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="Reports &amp; Analytics" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <VBox spacing="20" styleClass="card" style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 10; -fx-padding: 30;" alignment="CENTER">
        <FontIcon iconLiteral="fas-file-pdf" iconSize="64" style="-fx-icon-color: -color-danger-emphasis;"/>
        <Label text="Generate Complete Academic Report" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        <Label text="Export your subjects, grades, and pending tasks to a downloadable PDF document." style="-fx-text-fill: -color-fg-muted;"/>
        
        <Button text="Export as PDF" onAction="#handleExportPDF" styleClass="accent, large">
            <VBox.margin>
                <Insets top="20"/>
            </VBox.margin>
        </Button>
        
        <Label fx:id="statusLabel" wrapText="true" textAlignment="CENTER">
            <VBox.margin>
                <Insets top="10"/>
            </VBox.margin>
        </Label>
    </VBox>
</VBox>
