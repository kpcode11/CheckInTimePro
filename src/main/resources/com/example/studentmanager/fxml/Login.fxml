<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.studentmanager.controller.LoginController" style="-fx-background-color: -color-bg-subtle;">
    <VBox alignment="CENTER" maxWidth="400" maxHeight="450" spacing="20" styleClass="card" style="-fx-background-color: -color-bg-default; -fx-background-radius: 10; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.2), 15, 0, 0, 5);">
        <padding>
            <Insets top="40" right="40" bottom="40" left="40"/>
        </padding>
        
        <Label text="Welcome Back" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>
        <Label text="StudentManager Pro" style="-fx-text-fill: -color-fg-muted;"/>
        
        <VBox spacing="5">
            <Label text="Username"/>
            <TextField fx:id="usernameField" promptText="Enter your username"/>
        </VBox>
        
        <VBox spacing="5">
            <Label text="Password"/>
            <PasswordField fx:id="passwordField" promptText="Enter your password"/>
        </VBox>
        
        <HBox alignment="CENTER_LEFT" spacing="10">
            <CheckBox fx:id="rememberMeCheck" text="Remember me"/>
            <Region HBox.hgrow="ALWAYS" />
        </HBox>
        
        <Label fx:id="errorLabel" textFill="red" wrapText="true"/>
        
        <Button text="Login" maxWidth="Infinity" onAction="#handleLogin" styleClass="accent"/>
        
        <HBox alignment="CENTER" spacing="5">
            <Label text="Don't have an account?"/>
            <Hyperlink text="Sign Up" onAction="#handleGoToSignUp"/>
        </HBox>
    </VBox>
</StackPane>
