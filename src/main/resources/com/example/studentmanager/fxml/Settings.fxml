<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<VBox spacing="20" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.studentmanager.controller.SettingsController" style="-fx-background-color: transparent;">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="User Settings" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>

    <VBox spacing="15" styleClass="card" style="-fx-background-color: -color-bg-subtle; -fx-background-radius: 10; -fx-padding: 20;">
        <Label text="Preferences" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
        
        <GridPane hgap="20" vgap="15">
            <Label text="Default Theme:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
            <ComboBox fx:id="themeComboBox" prefWidth="200" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
            
            <Label text="Default Target Attendance %:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
            <Spinner fx:id="attendanceThresholdSpinner" prefWidth="200" GridPane.rowIndex="1" GridPane.columnIndex="1">
                <valueFactory>
                    <SpinnerValueFactory.IntegerSpinnerValueFactory min="0" max="100" initialValue="75" />
                </valueFactory>
            </Spinner>
            
            <Label text="Task Reminders (Push Notifications):" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
            <CheckBox fx:id="notificationsCheckBox" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
        </GridPane>
        
        <HBox alignment="CENTER_RIGHT">
            <Button text="Save Settings" onAction="#handleSaveSettings" styleClass="accent"/>
        </HBox>
    </VBox>
</VBox>
